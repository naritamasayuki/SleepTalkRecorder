    "Charging is recommended. Keep your device plugged in for overnight monitoring (works while screen is locked).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charging is recommended. Keep your device plugged in for overnight monitoring (works while screen is locked)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電しながらの利用をお勧めします。一晩中マイクを待機させるため、充電ケーブルに接続してご使用ください（画面ロック中も録音できます）。"
          }
        }
      }
    },
    "Chatting with someone you trust or listening to soothing music before sleep may help you feel grounded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatting with someone you trust or listening to soothing music before sleep may help you feel grounded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼できる人や家族と少し会話したり、安心できる音楽を聴いてから眠ると心が満たされます。"
          }
        }
      }
    },
    "Comfort Body Pillow": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
